# Copy the required entries into your untracked .env or host secret settings.
# These are placeholders, not working credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
ACS_CONNECTION_STRING=REPLACE_WITH_AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING
EMAIL_FROM=REPLACE_WITH_VERIFIED_ACS_SENDER
ADMIN_NOTIFY_EMAIL=founders@diracrobotics.com
AZURE_STORAGE_ACCOUNT=REPLACE_WITH_ACCOUNT_NAME
AZURE_STORAGE_KEY=REPLACE_WITH_ACCOUNT_KEY
AZURE_STORAGE_CONTAINER=media
AZURE_ASSET_BUNDLE_CONTAINER=asset-bundles
AZURE_SAMPLE_CONTAINER=private-samples
# Optional upload limits (bytes)
SAMPLE_MAX_FILES=20
SAMPLE_MAX_FILE_BYTES=524288000
SAMPLE_MAX_TOTAL_BYTES=2147483648
# Only for a local Azurite emulator, never production:
# AZURE_SAMPLE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
